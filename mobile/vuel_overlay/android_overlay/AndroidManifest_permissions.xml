    <!-- Notifications push (FCM) — obligatoire à partir d'Android 13 (API 33) pour
         que l'app puisse ne serait-ce que DEMANDER la permission d'afficher une
         notification système (cf. PushService.init côté Dart, qui appelle
         FirebaseMessaging.instance.requestPermission()). Sans cette ligne, la
         demande de permission échoue silencieusement sur Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
