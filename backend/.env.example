DATABASE_URL="postgresql://user:password@localhost:5432/vuel"
JWT_SECRET="change-me"
# REDIS_HOST="localhost"
# REDIS_PORT="6379"
# Laissés commentés : sans REDIS_HOST défini, le backend n'essaie de se
# connecter à AUCUN Redis (ni pour l'OTP, voir src/common/redis.service.ts, ni
# pour la file OCR des captures, voir src/ocr/ocr.module.ts) — tout tourne en
# mémoire/directement dans ce process. Pratique pour tester sans installer
# Redis. Décommente ces deux lignes si tu as un vrai Redis (local ou cloud,
# ex: Upstash) et veux l'utiliser à la place (recommandé en prod : retries
# automatiques et la file OCR survit à un redémarrage du serveur).
PORT="3000"

# Paiements
# La clé API Wave n'est PAS ici : elle se configure depuis le back-office admin
# (PATCH /admin/payment-config), stockée en base (table PaymentConfig).
# PAYSTACK_SECRET_KEY / FLUTTERWAVE_SECRET_KEY : réservés pour plus tard (non branchés).

# OCR
# Plus besoin de clé API : l'OCR tourne en local via Tesseract.js (voir
# src/ocr/ocr.processor.ts), aucune configuration nécessaire.

# SMS (OTP)
# Identifiants Twilio NON stockés ici : à configurer via le back-office admin
# (PATCH /admin/sms-config), stockés en base (table SmsConfig).

# Email (OTP, en doublon du SMS)
# Identifiants SMTP NON stockés ici non plus : à configurer via le back-office
# admin (PATCH /admin/email-config), stockés en base (table EmailConfig).
# Le code OTP part par SMS *et* par email quand l'utilisateur a renseigné une
# adresse — si l'un des deux canaux échoue, l'inscription continue avec l'autre.

# Telegram — vérification des scores
# Les captures ne sont stockées NULLE PART côté serveur (ni DB, ni S3) : elles
# partent directement vers ce chat Telegram, qui en devient la seule copie.
# TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."   # @BotFather
# TELEGRAM_CHAT_ID="-1001234567890"        # chat/canal où les captures sont relayées
# TELEGRAM_ADMIN_IDS="111111,222222"       # ids Telegram (pas pseudos) autorisés à
#                                           # trancher un duel via "/gagnant <équipe>"
#                                           # en réponse au message de capture — voir
#                                           # src/notifications/telegram-commands.service.ts
# TELEGRAM_BANNERS_CHAT_ID="-1009876543210" # optionnel — canal séparé pour les bannières
#                                           # promo de l'écran d'accueil (cf.
#                                           # AdminBannersController), pour ne pas polluer
#                                           # le canal d'arbitrage des preuves de score.
# PWA_URL="https://app.vuel.example"        # optionnel — URL de la PWA joueur si hébergée
#                                           # ailleurs que sur ce serveur (Vercel, Netlify...).
#                                           # Sans ça, la page d'invitation (cf.
#                                           # DuelInviteController) bascule sur /app, servi par
#                                           # ce serveur lui-même (cf. main.ts) quand l'app
#                                           # native ne s'ouvre pas (pas installée).
#                                           # Si absent, retombe sur TELEGRAM_CHAT_ID.
# Après config, activer le webhook une fois :
#   curl "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook?url=<BASE_URL>/telegram/webhook"

# Firebase Cloud Messaging
FCM_SERVER_KEY=""
